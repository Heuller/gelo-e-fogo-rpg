# ====================================================================
# VARIÁVEIS DE AMBIENTE: Crônicas de Sangue e Gelo (v2.1)
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA comite valores de produção no repositório Git!
# ====================================================================

# 1. Supabase (Banco de Dados & Autenticação)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_anon_key_aqui
SUPABASE_SECRET_KEY=sua_service_role_secret_key_aqui

# 2. Segurança & Acesso Exclusivo
ALLOWED_USER_EMAIL=seu_email_aqui@exemplo.com

# 3. Inteligência Artificial (Google Gemini)
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# 4. Limites e Circuit Breaker de IA
MAX_AI_DAILY_CALLS=100
MAX_AI_MONTHLY_DOLLARS=15

# 5. Ambiente de Execução
NODE_ENV=development
